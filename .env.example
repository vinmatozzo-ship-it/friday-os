# Shared secret required in the x-app-token header on every request.
# Without this, the deployed function is a public, unauthenticated endpoint
# with access to your Supabase memory store -- set a long random value.
APP_SHARED_SECRET=

# Which provider to use when the request doesn't specify one.
# One of: claude | gpt | kimi | qwen
DEFAULT_PROVIDER=claude

# Supabase (Paradigm Command Center project)
SUPABASE_URL=https://ggwwhsueqxgqtwokxrsu.supabase.co
# Service role key -- server-side only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Provider API keys -- only the ones you plan to use need to be set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
